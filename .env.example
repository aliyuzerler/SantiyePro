# ============================================================
# ŞantiyePro — Örnek Ortam Değişkenleri
# Bu dosya YALNIZCA değişken adlarını ve örnek değerleri içerir.
# Gerçek secret'ları içeren .env dosyası repoya eklenmez.
# ============================================================

# --- Genel ---
NODE_ENV=development
APP_VERSION=0.1.0

# --- API ---
API_PORT=4000
API_BASE_PATH=/api/v1
# Üretimde uzun, rastgele üretilmiş bir değer kullanın (ör. openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# İlk admin kurulum anahtarı (tek kullanımlık; en az 20 karakter, güçlü rastgele değer)
ADMIN_SETUP_TOKEN=change-me-setup-token-min-20-chars
# Web refresh cookie Secure bayrağı (HTTPS arkasında üretimde true)
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3100

# --- Veritabanı (PostgreSQL) ---
# Compose geliştirme ortamı için örnek; üretimde güçlü parola kullanın
DATABASE_URL=postgresql://santiyepro:santiyepro@localhost:5433/santiyepro?schema=public

# --- Nesne depolama (S3 uyumlu / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=santiyepro-media
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key

# --- Web paneli ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# --- Faz 10: yedekleme ve dışa aktarma ---
# Backup script'inin (infra/scripts/backup.sh) yazdığı durum dosyası;
# API yalnızca okur (GET /org/backup-status). Compose'da /backups/status.json.
# BACKUP_STATUS_FILE=/backups/status.json
# Rapor dışa aktarma satır sınırı (aşımında 400 döner)
# EXPORT_ROW_LIMIT=10000
