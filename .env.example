# ============================================================
# ŞantiyePro — Örnek Ortam Değişkenleri
# Bu dosya YALNIZCA değişken adlarını ve örnek değerleri içerir.
# Gerçek secret'ları içeren .env dosyası repoya eklenmez.
# ============================================================

# --- Genel ---
NODE_ENV=development
APP_VERSION=0.1.0

# --- API ---
API_PORT=4000
API_BASE_PATH=/api/v1
# Üretimde uzun, rastgele üretilmiş bir değer kullanın (ör. openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
CORS_ALLOWED_ORIGINS=http://localhost:3100

# --- Veritabanı (PostgreSQL) ---
# Compose geliştirme ortamı için örnek; üretimde güçlü parola kullanın
DATABASE_URL=postgresql://santiyepro:santiyepro@localhost:5433/santiyepro?schema=public

# --- Nesne depolama (S3 uyumlu / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=santiyepro-media
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key

# --- Web paneli ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
