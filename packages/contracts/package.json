{
  "name": "@santiyepro/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Paylaşılan API sözleşmeleri: DTO tipleri, şemalar, hata zarfı ve tasarım token'ları",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@santiyepro/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^5.1.0"
  }
}
