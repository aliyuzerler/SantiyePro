// ŞantiyePro — Prisma şeması (Faz 04: görev yönetimi)
//
// Veri modeli taslağı: docs/04-data-model.md (User/Role/Permission/UserRole/
// RolePermission/ProjectMember + oturum ve denetim tabloları).
// Kurallar: docs/06-roles-permissions.md, docs/07-security-rules.md
// - Parola hash'i yalnızca Argon2id çıktısı olarak saklanır (düz metin yasak).
// - Refresh / parola sıfırlama token'ları yalnızca SHA-256 hash olarak saklanır.
// - AuditLog append-only: update/delete API'leri yoktur.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  roles          UserRole[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  auditLogs      AuditLog[]
  projectMembers ProjectMember[]
  managedProjects Project[]    @relation("ProjectManager")
  assignedTasks  Task[]       @relation("TaskAssignee")
  createdTasks   Task[]       @relation("TaskCreator")
  taskComments   TaskComment[]
  taskStatusChanges TaskStatusHistory[] @relation("TaskStatusChanger")
  notifications  Notification[]
  createdDailyReports DailyReport[]      @relation("DailyReportCreator")
  approvedDailyReports DailyReport[]     @relation("DailyReportApprover")
  dailyReportRevisions DailyReportRevision[] @relation("DailyReportRevisionAuthor")
  mediaFiles     MediaFile[]

  @@index([status])
}

/// Proje — kurulum içinde benzersiz kod; silme yok, arşiv = ARCHIVED status
/// (bağlı kayıtlara dokunulmaz; prompts/phase-03-development.md).
/// Tarih alanları PostgreSQL DATE kolonunda saklanır (timezone-safe).
model Project {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  clientName     String?
  description    String?
  address        String?
  startDate      DateTime?     @db.Date
  plannedEndDate DateTime?     @db.Date
  actualEndDate  DateTime?     @db.Date
  /// DECIMAL(18,2) — API'de decimal string olarak taşınır (docs/05).
  contractAmount Decimal?      @db.Decimal(18, 2)
  currency       String        @default("TRY")
  status         ProjectStatus @default(PLANNING)
  managerId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  manager  User?           @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  members  ProjectMember[]
  sites    Site[]
  tasks    Task[]
  dailyReports DailyReport[]

  @@index([status])
  @@index([name])
}

/// Şantiye/alan — yalnızca doğru projeye bağlanır; ad proje içinde benzersizdir.
model Site {
  id        String     @id @default(cuid())
  projectId String
  name      String
  address   String?
  status    SiteStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  dailyReports DailyReport[]

  @@unique([projectId, name])
  @@index([projectId])
}

/// Görev (Faz 04) — durum akışı kurallı (contracts TASK_STATUS_TRANSITIONS),
/// checklist/fileRefs Json kolonu, version iyimser eşzamanlılık içindir (docs/04).
/// Index önerileri docs/04: (projectId, status, dueAt), (assigneeId, status).
model Task {
  id          String       @id @default(cuid())
  projectId   String
  siteId      String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  /// Termin — timezone'lu timestamp (timestamptz); ISO 8601 olarak taşınır.
  dueAt       DateTime?
  completedAt DateTime?
  /// Checklist kalemleri: TaskChecklistItem[] (contracts şeması) — tam liste değişimi.
  checklist   Json         @default("[]")
  /// Dosya referansları: TaskFileRef[] — medya modülü sonraki fazlarda bağlanır.
  fileRefs    Json         @default("[]")
  /// İyimser eşzamanlılık: her güncellemede +1 (docs/04).
  version     Int          @default(1)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site     Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  comments      TaskComment[]
  statusHistory TaskStatusHistory[]

  @@index([projectId, status, dueAt])
  @@index([assigneeId, status])
}

/// Görev yorumu — append-only listeleme; silme MVP kapsamı dışında.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

/// Görev durum geçmişi — autoincrement id ile katı sıra garantisi;
/// ilk kayıt oluşturmada fromStatus=null → TODO.
model TaskStatusHistory {
  id          Int         @id @default(autoincrement())
  taskId      String
  fromStatus  TaskStatus?
  toStatus    TaskStatus
  changedById String
  changedAt   DateTime    @default(now())

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User @relation("TaskStatusChanger", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([taskId, changedAt])
}

/// Uygulama içi bildirim olayları (Faz 04) — gerçek push sağlayıcısı sonraki fazda;
/// atama vb. olaylar buraya yazılır (event kaydı = bildirim altyapısı temeli).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

enum DailyReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum MediaScanStatus {
  /// upload-url üretilip dosya henüz yüklenmedi
  PENDING
  /// yüklendi, EXIF soyuldu, magic-byte doğrulandı
  CLEAN
  /// reddedildi (tür/boyut uyumsuz vb.)
  FLAGGED
}

/// Günlük şantiye raporu (Faz 05) — docs/04; durum akışı docs/05.
/// Rapor tarihi PostgreSQL DATE kolonunda (timezone-safe).
model DailyReport {
  id                String            @id @default(cuid())
  projectId         String
  siteId            String?
  reportDate        DateTime          @db.Date
  weather           String?
  workSummary       String
  workforceSummary  String?
  equipmentSummary  String?
  issues            String?
  safetyNotes       String?
  nextDayPlan       String?
  status            DailyReportStatus @default(DRAFT)
  /// Snapshot alındıkça artar; revizyon geçmişi DailyReportRevision'dadır.
  revisionNo        Int               @default(0)
  createdById       String
  submittedAt       DateTime?
  approvedById      String?
  approvedAt        DateTime?
  rejectedReason    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site       Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdBy  User    @relation("DailyReportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?   @relation("DailyReportApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  workers   DailyReportWorker[]
  media     DailyReportMedia[]
  revisions DailyReportRevision[]

  @@index([projectId, reportDate])
  @@index([status])
}

/// Rapordaki ekip/personel özeti (Personel modülü sonraki fazlarda bağlanır).
model DailyReportWorker {
  id          String  @id @default(cuid())
  reportId    String
  name        String
  jobTitle    String?
  workerCount Int     @default(1)
  hours       Decimal @db.Decimal(5, 2)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

/// Önceki içerik snapshot'ı — append-only; onaylı/gönderilmiş rapor düzenlenince oluşur.
model DailyReportRevision {
  id          String   @id @default(cuid())
  reportId    String
  /// Snapshot'ın alındığı revizyon numarası (düzenleme öncesi değer).
  revisionNo  Int
  snapshot    Json
  contentHash String
  createdById String
  createdAt   DateTime @default(now())

  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdBy User        @relation("DailyReportRevisionAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([reportId, revisionNo])
  @@index([reportId])
}

/// Rapor–medya ilişkisi (ek sırası korunur).
model DailyReportMedia {
  reportId  String
  mediaId   String
  sortOrder Int     @default(0)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  media  MediaFile   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([reportId, mediaId])
  @@index([reportId])
}

/// Medya dosyası — private depoda, sunucu üretimi storageKey ile (docs/07).
/// storageKey istemciye asla dönmez; erişim yalnızca kısa ömürlü imzalı URL ile.
model MediaFile {
  id           String          @id @default(cuid())
  projectId    String?
  storageKey   String          @unique
  originalName String
  mimeType     String
  sizeBytes    Int             @default(0)
  checksum     String?
  scanStatus   MediaScanStatus @default(PENDING)
  uploadedById String
  createdAt    DateTime        @default(now())

  uploader User    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  reports  DailyReportMedia[]
}


model Role {
  id       String  @id @default(cuid())
  key      String  @unique
  label    String
  isSystem Boolean @default(false)

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  roles RolePermission[]
}

model UserRole {
  userId      String
  roleId      String
  assignedAt  DateTime @default(now())
  assignedBy  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Proje kapsamı kontrolü: kullanıcının hangi projede hangi rolle çalıştığı.
/// FIRM_ADMIN tüm projelere erişir; diğer roller yalnızca üyesi olduğu projeleri
/// görür (kapsam dışı proje 404 döner — IDOR koruması, docs/06).
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  /// Proje içi rol anahtarı (MANAGER, CHIEF, TECH_OFFICE, WAREHOUSE, ACCOUNTING, WORKER).
  scopeRole String   @default("WORKER")
  createdAt DateTime @default(now())
  assignedBy String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

/// Oturum yenileme token'ları — yalnızca hash saklanır.
/// Rotasyon: eski token revokedAt + replacedBy ile işaretlenir; aynı familyId'deki
/// token'ların tekrar kullanımı (reuse) ailenin tamamını iptal eder (docs/07).
model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  familyId    String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
}

/// Parola sıfırlama token'ları — tek kullanımlık, süreli, hash'lenmiş (docs/07).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Denetim günlüğü — append-only (docs/07: kritik iş kayıtları).
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  userAgent   String?
  traceId     String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}
