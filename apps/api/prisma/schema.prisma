// ŞantiyePro — Prisma şeması (Faz 07: depo, malzeme ve stok hareketleri)
//
// Veri modeli taslağı: docs/04-data-model.md (User/Role/Permission/UserRole/
// RolePermission/ProjectMember + oturum ve denetim tabloları).
// Kurallar: docs/06-roles-permissions.md, docs/07-security-rules.md
// - Parola hash'i yalnızca Argon2id çıktısı olarak saklanır (düz metin yasak).
// - Refresh / parola sıfırlama token'ları yalnızca SHA-256 hash olarak saklanır.
// - AuditLog append-only: update/delete API'leri yoktur.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PersonnelStatus {
  ACTIVE
  PASSIVE
}

/// Kaydın yazıldığı istemci kanalı — audit/sync analizlerinde kullanılır (docs/09).
enum AttendanceSource {
  WEB
  MOBILE
  API
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  roles          UserRole[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  auditLogs      AuditLog[]
  projectMembers ProjectMember[]
  managedProjects Project[]    @relation("ProjectManager")
  assignedTasks  Task[]       @relation("TaskAssignee")
  createdTasks   Task[]       @relation("TaskCreator")
  taskComments   TaskComment[]
  taskStatusChanges TaskStatusHistory[] @relation("TaskStatusChanger")
  notifications  Notification[]
  createdDailyReports DailyReport[]      @relation("DailyReportCreator")
  approvedDailyReports DailyReport[]     @relation("DailyReportApprover")
  dailyReportRevisions DailyReportRevision[] @relation("DailyReportRevisionAuthor")
  mediaFiles     MediaFile[]
  createdPersonnel    Personnel[]        @relation("PersonnelCreator")
  recordedAttendance  AttendanceRecord[] @relation("AttendanceRecorder")
  createdWarehouses   Warehouse[]        @relation("WarehouseCreator")
  createdMaterials    Material[]         @relation("MaterialCreator")
  stockMovements      StockMovement[]    @relation("StockMovementCreator")
  expenseCategories   ExpenseCategory[]  @relation("ExpenseCategoryCreator")
  createdExpenses     Expense[]          @relation("ExpenseCreator")
  approvedExpenses    Expense[]          @relation("ExpenseApprover")
  createdContractItems ContractItem[]    @relation("ContractItemCreator")
  createdClaims       ProgressClaim[]    @relation("ProgressClaimCreator")
  approvedClaims      ProgressClaim[]    @relation("ProgressClaimApprover")

  @@index([status])
}

/// Proje — kurulum içinde benzersiz kod; silme yok, arşiv = ARCHIVED status
/// (bağlı kayıtlara dokunulmaz; prompts/phase-03-development.md).
/// Tarih alanları PostgreSQL DATE kolonunda saklanır (timezone-safe).
model Project {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  clientName     String?
  description    String?
  address        String?
  startDate      DateTime?     @db.Date
  plannedEndDate DateTime?     @db.Date
  actualEndDate  DateTime?     @db.Date
  /// DECIMAL(18,2) — API'de decimal string olarak taşınır (docs/05).
  contractAmount Decimal?      @db.Decimal(18, 2)
  currency       String        @default("TRY")
  status         ProjectStatus @default(PLANNING)
  managerId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  manager  User?           @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  members  ProjectMember[]
  sites    Site[]
  tasks    Task[]
  dailyReports DailyReport[]
  attendanceRecords AttendanceRecord[]
  warehouses Warehouse[]
  stockMovements StockMovement[]
  expenses       Expense[]
  contractItems  ContractItem[]
  progressClaims ProgressClaim[]

  @@index([status])
  @@index([name])
}

/// Şantiye/alan — yalnızca doğru projeye bağlanır; ad proje içinde benzersizdir.
model Site {
  id        String     @id @default(cuid())
  projectId String
  name      String
  address   String?
  status    SiteStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  dailyReports DailyReport[]
  attendanceRecords AttendanceRecord[]

  @@unique([projectId, name])
  @@index([projectId])
}

/// Görev (Faz 04) — durum akışı kurallı (contracts TASK_STATUS_TRANSITIONS),
/// checklist/fileRefs Json kolonu, version iyimser eşzamanlılık içindir (docs/04).
/// Index önerileri docs/04: (projectId, status, dueAt), (assigneeId, status).
model Task {
  id          String       @id @default(cuid())
  projectId   String
  siteId      String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  /// Termin — timezone'lu timestamp (timestamptz); ISO 8601 olarak taşınır.
  dueAt       DateTime?
  completedAt DateTime?
  /// Checklist kalemleri: TaskChecklistItem[] (contracts şeması) — tam liste değişimi.
  checklist   Json         @default("[]")
  /// Dosya referansları: TaskFileRef[] — medya modülü sonraki fazlarda bağlanır.
  fileRefs    Json         @default("[]")
  /// İyimser eşzamanlılık: her güncellemede +1 (docs/04).
  version     Int          @default(1)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site     Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  comments      TaskComment[]
  statusHistory TaskStatusHistory[]

  @@index([projectId, status, dueAt])
  @@index([assigneeId, status])
}

/// Görev yorumu — append-only listeleme; silme MVP kapsamı dışında.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

/// Görev durum geçmişi — autoincrement id ile katı sıra garantisi;
/// ilk kayıt oluşturmada fromStatus=null → TODO.
model TaskStatusHistory {
  id          Int         @id @default(autoincrement())
  taskId      String
  fromStatus  TaskStatus?
  toStatus    TaskStatus
  changedById String
  changedAt   DateTime    @default(now())

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User @relation("TaskStatusChanger", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([taskId, changedAt])
}

/// Uygulama içi bildirim olayları (Faz 04) — gerçek push sağlayıcısı sonraki fazda;
/// atama vb. olaylar buraya yazılır (event kaydı = bildirim altyapısı temeli).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

enum DailyReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum MediaScanStatus {
  /// upload-url üretilip dosya henüz yüklenmedi
  PENDING
  /// yüklendi, EXIF soyuldu, magic-byte doğrulandı
  CLEAN
  /// reddedildi (tür/boyut uyumsuz vb.)
  FLAGGED
}

/// Günlük şantiye raporu (Faz 05) — docs/04; durum akışı docs/05.
/// Rapor tarihi PostgreSQL DATE kolonunda (timezone-safe).
model DailyReport {
  id                String            @id @default(cuid())
  projectId         String
  siteId            String?
  reportDate        DateTime          @db.Date
  weather           String?
  workSummary       String
  workforceSummary  String?
  equipmentSummary  String?
  issues            String?
  safetyNotes       String?
  nextDayPlan       String?
  status            DailyReportStatus @default(DRAFT)
  /// Snapshot alındıkça artar; revizyon geçmişi DailyReportRevision'dadır.
  revisionNo        Int               @default(0)
  createdById       String
  submittedAt       DateTime?
  approvedById      String?
  approvedAt        DateTime?
  rejectedReason    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site       Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdBy  User    @relation("DailyReportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?   @relation("DailyReportApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  workers   DailyReportWorker[]
  media     DailyReportMedia[]
  revisions DailyReportRevision[]

  @@index([projectId, reportDate])
  @@index([status])
}

/// Rapordaki ekip/personel özeti (Personel modülü sonraki fazlarda bağlanır).
model DailyReportWorker {
  id          String  @id @default(cuid())
  reportId    String
  name        String
  jobTitle    String?
  workerCount Int     @default(1)
  hours       Decimal @db.Decimal(5, 2)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

/// Önceki içerik snapshot'ı — append-only; onaylı/gönderilmiş rapor düzenlenince oluşur.
model DailyReportRevision {
  id          String   @id @default(cuid())
  reportId    String
  /// Snapshot'ın alındığı revizyon numarası (düzenleme öncesi değer).
  revisionNo  Int
  snapshot    Json
  contentHash String
  createdById String
  createdAt   DateTime @default(now())

  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdBy User        @relation("DailyReportRevisionAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([reportId, revisionNo])
  @@index([reportId])
}

/// Rapor–medya ilişkisi (ek sırası korunur).
model DailyReportMedia {
  reportId  String
  mediaId   String
  sortOrder Int     @default(0)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  media  MediaFile   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([reportId, mediaId])
  @@index([reportId])
}

/// Medya dosyası — private depoda, sunucu üretimi storageKey ile (docs/07).
/// storageKey istemciye asla dönmez; erişim yalnızca kısa ömürlü imzalı URL ile.
model MediaFile {
  id           String          @id @default(cuid())
  projectId    String?
  storageKey   String          @unique
  originalName String
  mimeType     String
  sizeBytes    Int             @default(0)
  checksum     String?
  scanStatus   MediaScanStatus @default(PENDING)
  uploadedById String
  createdAt    DateTime        @default(now())

  uploader User    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  reports  DailyReportMedia[]
  expenseReceipts Expense[]
}


model Role {
  id       String  @id @default(cuid())
  key      String  @unique
  label    String
  isSystem Boolean @default(false)

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  roles RolePermission[]
}

model UserRole {
  userId      String
  roleId      String
  assignedAt  DateTime @default(now())
  assignedBy  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Proje kapsamı kontrolü: kullanıcının hangi projede hangi rolle çalıştığı.
/// FIRM_ADMIN tüm projelere erişir; diğer roller yalnızca üyesi olduğu projeleri
/// görür (kapsam dışı proje 404 döner — IDOR koruması, docs/06).
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  /// Proje içi rol anahtarı (MANAGER, CHIEF, TECH_OFFICE, WAREHOUSE, ACCOUNTING, WORKER).
  scopeRole String   @default("WORKER")
  createdAt DateTime @default(now())
  assignedBy String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

/// Oturum yenileme token'ları — yalnızca hash saklanır.
/// Rotasyon: eski token revokedAt + replacedBy ile işaretlenir; aynı familyId'deki
/// token'ların tekrar kullanımı (reuse) ailenin tamamını iptal eder (docs/07).
model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  familyId    String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
}

/// Parola sıfırlama token'ları — tek kullanımlık, süreli, hash'lenmiş (docs/07).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Denetim günlüğü — append-only (docs/07: kritik iş kayıtları).
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  userAgent   String?
  traceId     String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Personel (Faz 06) — kurum genelindeki işçi/taşeron kaydı; sert silme yok,
/// pasife alma vardır (append-only iş kayıtları felsefesi, docs/02).
/// Kişisel veri minimumda tutulur (docs/06: saha personeli verisi).
model Personnel {
  id                     String          @id @default(cuid())
  /// Sicil numarası — kurum içinde benzersiz (verilirse).
  employeeCode           String?         @unique
  fullName               String
  phone                  String?
  jobTitle               String?
  companyOrSubcontractor String?
  status                 PersonnelStatus @default(ACTIVE)
  createdById            String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  createdBy         User              @relation("PersonnelCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]

  @@index([status, fullName])
  @@index([fullName])
}

/// Puantaj kaydı (Faz 06) — aynı personel/proje/tarih/vardiya için tek satır:
/// DB unique constraint + servis kontrolü (docs/04 unique örneği).
/// workDate takvim günüdür (DATE kolonu, timezone-safe); checkIn/Out timestamptz.
/// status varsayılan 6 durum + kuruma özel anahtarlar (OrgSettings) ile String
/// olarak doğrulanır — enum'e sabitlemeden genişletilebilirlik (Faz 06 promptu).
/// GPS alanı YOKTUR: konum toplama varsayılan kapalı, izinli ve görünür
/// bilgilendirmeyle ancak işlem anında açılabilir (docs/07).
model AttendanceRecord {
  id               String           @id @default(cuid())
  projectId        String
  siteId           String?
  personnelId      String
  workDate         DateTime         @db.Date
  shiftKey         String           @default("GUNDUZ")
  status           String           @default("PRESENT")
  checkInAt        DateTime?
  checkOutAt       DateTime?
  workedMinutes    Int?
  note             String?
  recordedById     String
  source           AttendanceSource @default(WEB)
  /// Çevrimdışı kuyruk idempotency anahtarı (docs/09 outbox ile birebir).
  clientMutationId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site      Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  personnel Personnel @relation(fields: [personnelId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  /// Duplicate engeli: aynı personel/proje/gün/vardiya tek kayıttır.
  @@unique([personnelId, projectId, workDate, shiftKey])
  @@index([projectId, workDate])
  @@index([personnelId, workDate])
  @@index([personnelId, projectId, workDate])
}

/// Kurum ayarları (Faz 06) — tek satırlık singleton; devam durumlarının kurum
/// tanımlı uzantıları burada tutulur (Faz 06 geliştirme promptu:
/// "kurum ayarıyla genişletilebilir"). Yalnızca FIRM_SETTINGS_MANAGE değiştirebilir.
model OrgSettings {
  id                       String   @id @default("default")
  /// CustomAttendanceStatus[] — [{ key, label }] Json listesi.
  attendanceCustomStatuses Json     @default("[]")
  updatedAt                DateTime @updatedAt
}

/// Depo (Faz 07) — docs/04. projectId null = kurum genel merkezi deposu
/// (proje kapsamı yok, tüm inventory.view sahipleri görür); proje deposu
/// üyelik kapsamındadır. Append-only felsefe: depo pasife alınır (isActive),
/// hareketi olan depo sert silinmez.
model Warehouse {
  id          String   @id @default(cuid())
  projectId   String?
  name        String
  location    String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User           @relation("WarehouseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  movements StockMovement[] @relation("StockMovementSource")
  incoming  StockMovement[] @relation("StockMovementTarget")
  balances  StockBalance[]

  @@index([projectId])
  @@index([name])
}

/// Malzeme (Faz 07) — kurum genelinde tek katalog; birim ve minimum stok
/// bilgilendirmesi buradan gelir. Pasife malzemeye yeni hareket girilmez.
model Material {
  id          String   @id @default(cuid())
  /// Kurum içinde benzersiz kod (verilirse) — nullable unique, çoklu NULL serbest.
  code        String?  @unique
  name        String
  category    String?
  unit        String   @default("ADET")
  /// Minimum stok: bakiye kartında "kritik stok" uyarısı için (DECIMAL(18,3)).
  minStock    Decimal? @db.Decimal(18, 3)
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User           @relation("MaterialCreator", fields: [createdById], references: [id], onDelete: Restrict)
  movements StockMovement[]
  balances  StockBalance[]

  @@index([name])
  @@index([isActive])
}

/// Stok bakiyesi (Faz 07) — hareket kaydı asıl kaynaktır (docs/04); bu tablo
/// transaction içi koşullu atomik UPDATE ile güncellenen okuma modelidir.
/// Negatif stok engeli buradan gelir: UPDATE ... WHERE quantity >= miktar —
/// eşzamanlı çıkışta predicate yeniden değerlendirilir, yetersizse satır
/// güncellenmez (0 row) ve hareket 409 ile reddedilir.
model StockBalance {
  id             String   @id @default(cuid())
  materialId     String
  warehouseId    String
  quantity       Decimal  @default(0) @db.Decimal(18, 3)
  lastMovementAt DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([materialId, warehouseId])
  @@index([materialId])
  @@index([warehouseId])
}

/// Stok hareketi (Faz 07) — APPEND-ONLY: update/delete API'si yoktur
/// (docs/04 "hareket kaydı asıl kaynaktır", docs/02 iş kayıtları felsefesi).
/// Düzeltme yalnızca REVERSAL ile: reversesMovementId unique → bir hareket
/// en fazla bir kez ters kaydedilir; REVERSAL'ın REVERSAL'ı yoktur.
/// TRANSFER tek satırdır: warehouseId kaynak, targetWarehouseId hedef;
/// bakiye etkileri tek DB transaction'da uygulanır (docs/05).
/// quantity kanonik ondalık string semantiğiyle DECIMAL(18,3) saklanır;
/// ADJUSTMENT işaretli olabilir, diğer tipler pozitiftir.
model StockMovement {
  id                 String   @id @default(cuid())
  materialId         String
  warehouseId        String
  /// TRANSFER hedef deposu; diğer tiplerde null.
  targetWarehouseId  String?
  projectId          String?
  type               String
  quantity           Decimal  @db.Decimal(18, 3)
  unitCost           Decimal? @db.Decimal(18, 4)
  referenceType      String?
  referenceId        String?
  note               String?
  occurredAt         DateTime @default(now())
  createdById        String
  /// Bu hareketin ters kaydı olduğu orijinal hareket (yalnızca REVERSAL'da).
  reversesMovementId String?  @unique
  /// Çevrimdışı kuyruk idempotency anahtarı — unique: tekrar gönderim stok
  /// ikinci kez düşürmez, mevcut hareket döner (docs/09).
  clientMutationId   String?  @unique
  createdAt          DateTime @default(now())

  material        Material       @relation(fields: [materialId], references: [id], onDelete: Restrict)
  warehouse       Warehouse      @relation("StockMovementSource", fields: [warehouseId], references: [id], onDelete: Restrict)
  targetWarehouse Warehouse?     @relation("StockMovementTarget", fields: [targetWarehouseId], references: [id], onDelete: Restrict)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy       User           @relation("StockMovementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reverses        StockMovement? @relation("StockReversal", fields: [reversesMovementId], references: [id], onDelete: Restrict)
  reversedBy      StockMovement? @relation("StockReversal")

  @@index([materialId, warehouseId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([warehouseId, occurredAt])
  @@index([type, occurredAt])
}

/// Gider kategorisi (Faz 08) — kurum genelinde; ad benzersiz. Pasife kategori
/// yeni giderde seçilemez (mevcut giderler etkilenmez).
model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User      @relation("ExpenseCategoryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  expenses  Expense[]

  @@index([isActive])
}

/// Gider (Faz 08) — proje kapsamlı; DRAFT'ta düzenlenebilir/silinebilir,
/// PENDING onay/rede gider, APPROVED/REJECTED değiştirilemez (append-only
/// iş kayıtları felsefesi). Vergi oranı OPSİYONELDİR: verilmezse hiçbir
/// varsayılan oran uygulanmaz (uydurma yasal hesap yasak).
/// amount DECIMAL(18,2); taxRate DECIMAL(5,2); currency 3 harf (TRY varsayılan).
model Expense {
  id              String        @id @default(cuid())
  projectId       String
  categoryId      String
  vendorName      String?
  description     String
  amount          Decimal       @db.Decimal(18, 2)
  currency        String        @default("TRY")
  taxRate         Decimal?      @db.Decimal(5, 2)
  expenseDate     DateTime      @db.Date
  status          ExpenseStatus @default(DRAFT)
  /// Fiş/fatura eki — Faz 05 özel medya deposundan (receiptMedia).
  receiptMediaId  String?
  submittedAt     DateTime?
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  /// Taslak gider sert silinmez; soft delete (audit izi korunur).
  deletedAt       DateTime?

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  receiptMedia MediaFile?     @relation(fields: [receiptMediaId], references: [id], onDelete: SetNull)
  approvedBy  User?           @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy   User            @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, expenseDate])
  @@index([projectId, status])
  @@index([categoryId])
  @@index([status, expenseDate])
}

enum ExpenseStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

/// Sözleşme kalemi (Faz 08) — proje kapsamlı hakediş kalemi. unitPrice
/// değiştirilebilir; ancak hakediş satırı SNAPSHOT sakladığı için eski
/// hakedişler etkilenmez (docs/04). code verilirse proje içinde benzersiz.
model ContractItem {
  id               String   @id @default(cuid())
  projectId        String
  /// Proje içinde benzersiz kalem kodu (verilirse) — nullable unique.
  code             String?
  description      String
  unit             String
  /// Sözleşme miktarı DECIMAL(18,3) — m²/m³/ton gibi 3 ondalık hassasiyet.
  contractQuantity Decimal  @db.Decimal(18, 3)
  /// Birim fiyat DECIMAL(18,4); hakedişte snapshot alınır.
  unitPrice        Decimal  @db.Decimal(18, 4)
  currency         String   @default("TRY")
  sortOrder        Int      @default(0)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("ContractItemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  claimLines  ProgressClaimLine[]

  @@unique([projectId, code])
  @@index([projectId, sortOrder])
}

/// Hakediş (Faz 08) — dönemsel iş tamamlama beyanı. claimNo proje içinde
/// benzersiz; dönemler (REJECTED/CANCELLED hariç) üst üste binemez.
/// Onaylandıktan sonra satırlar ve toplamlar DONDUZULUR: fiyat değişimi
/// snapshot sayesinde eski hakedişi etkilemez; düzeltme ancak yeni (mahsup)
/// hakedişle yapılır. İptal yalnızca DRAFT/PENDING'de mümkündür.
model ProgressClaim {
  id              String              @id @default(cuid())
  projectId       String
  claimNo         Int
  periodStart     DateTime            @db.Date
  periodEnd       DateTime            @db.Date
  status          ProgressClaimStatus @default(DRAFT)
  /// Zincirden gelen önceki hakediş(ler)in kümülatif toplamı (DECIMAL(18,2)).
  previousTotal   Decimal             @default(0) @db.Decimal(18, 2)
  /// Brüt = Σ dönem tutarı (DECIMAL(18,2)).
  grossTotal      Decimal             @default(0) @db.Decimal(18, 2)
  /// Kümülatif = previousTotal + grossTotal (DECIMAL(18,2)).
  cumulativeTotal Decimal             @default(0) @db.Decimal(18, 2)
  /// Kesinti toplamı — brütü aşamaz; oranı uydurulmaz, yapılandırılabilir alan.
  deductionTotal  Decimal             @default(0) @db.Decimal(18, 2)
  /// Net = grossTotal − deductionTotal (DECIMAL(18,2)).
  netTotal        Decimal             @default(0) @db.Decimal(18, 2)
  notes           String?
  submittedAt     DateTime?
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  cancelReason    String?
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines     ProgressClaimLine[]
  approvedBy User?              @relation("ProgressClaimApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy User                @relation("ProgressClaimCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, claimNo])
  @@index([projectId, periodStart])
  @@index([projectId, status])
  @@index([status, periodStart])
}

enum ProgressClaimStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Hakediş satırı (Faz 08) — bir kalem × bir hakediş. unitPriceSnapshot
/// oluşturma anındaki kalem fiyatıdır: sözleşme fiyatı sonradan değişse
/// bile bu satır değişmez (docs/04 snapshot kuralı). Miktarlar DECIMAL(18,3),
/// tutarlar DECIMAL(18,2) — yarım yukarı yuvarlama (contracts/finance.ts).
model ProgressClaimLine {
  id               String   @id @default(cuid())
  progressClaimId  String
  contractItemId   String
  previousQuantity Decimal  @db.Decimal(18, 3)
  periodQuantity   Decimal  @db.Decimal(18, 3)
  cumulativeQuantity Decimal @db.Decimal(18, 3)
  unitPriceSnapshot Decimal @db.Decimal(18, 4)
  lineAmount       Decimal  @db.Decimal(18, 2)

  claim        ProgressClaim @relation(fields: [progressClaimId], references: [id], onDelete: Cascade)
  contractItem ContractItem  @relation(fields: [contractItemId], references: [id], onDelete: Restrict)

  @@unique([progressClaimId, contractItemId])
  @@index([contractItemId])
}
