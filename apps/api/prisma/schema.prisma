// ŞantiyePro — Prisma şeması (Faz 02: Kimlik doğrulama, kullanıcılar, RBAC)
//
// Veri modeli taslağı: docs/04-data-model.md (User/Role/Permission/UserRole/
// RolePermission/ProjectMember + oturum ve denetim tabloları).
// Kurallar: docs/06-roles-permissions.md, docs/07-security-rules.md
// - Parola hash'i yalnızca Argon2id çıktısı olarak saklanır (düz metin yasak).
// - Refresh / parola sıfırlama token'ları yalnızca SHA-256 hash olarak saklanır.
// - AuditLog append-only: update/delete API'leri yoktur.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  roles          UserRole[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  auditLogs      AuditLog[]
  projectMembers ProjectMember[]

  @@index([status])
}

model Role {
  id       String  @id @default(cuid())
  key      String  @unique
  label    String
  isSystem Boolean @default(false)

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  roles RolePermission[]
}

model UserRole {
  userId      String
  roleId      String
  assignedAt  DateTime @default(now())
  assignedBy  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Proje kapsamı kontrolü: kullanıcının hangi projede hangi rolle çalıştığı.
/// Project modeli Faz 03'te eklenince projectId'ye FK eklenecek (geçici olarak String).
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  /// Proje içi rol anahtarı (ör. MANAGER, CHIEF, WORKER) — Faz 03'te doldurulur.
  scopeRole String   @default("MEMBER")
  createdAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
}

/// Oturum yenileme token'ları — yalnızca hash saklanır.
/// Rotasyon: eski token revokedAt + replacedBy ile işaretlenir; aynı familyId'deki
/// token'ların tekrar kullanımı (reuse) ailenin tamamını iptal eder (docs/07).
model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  familyId    String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
}

/// Parola sıfırlama token'ları — tek kullanımlık, süreli, hash'lenmiş (docs/07).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Denetim günlüğü — append-only (docs/07: kritik iş kayıtları).
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  userAgent   String?
  traceId     String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}
