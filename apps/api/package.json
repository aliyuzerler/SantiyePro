{
  "name": "@santiyepro/api",
  "version": "1.0.0",
  "private": true,
  "description": "ŞantiyePro API — NestJS + Prisma (modüler monolit)",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prisma:generate": "unset DATABASE_URL && prisma generate",
    "prisma:migrate": "unset DATABASE_URL && prisma migrate dev",
    "prisma:deploy": "unset DATABASE_URL && prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/config": "12.1.0",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.19.0",
    "@santiyepro/contracts": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "jose": "^6.2.15",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.3",
    "@santiyepro/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "prisma": "6.19.0",
    "supertest": "^7.3.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.2"
  }
}
