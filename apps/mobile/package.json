{
  "name": "@santiyepro/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "ŞantiyePro mobil saha uygulaması — React Native + Expo (offline-first)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@santiyepro/contracts": "workspace:*",
    "expo": "~58.0.23",
    "expo-file-system": "^58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-secure-store": "^58.0.2",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.68.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@eslint/js": "^9.17.0",
    "@santiyepro/config": "workspace:*",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.1",
    "eslint": "^9.17.0",
    "jest": "30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.3.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.19.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/src/test/shims/lucide.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|lucide-react-native|react-native-svg|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/|@expo-google-fonts/|react-navigation|@react-navigation/))"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "expo": {
    "autolinking": {}
  }
}