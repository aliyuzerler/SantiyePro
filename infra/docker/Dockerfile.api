# ŞantiyePro API — üretim imajı
# Non-root kullanıcı, minimal imaj, healthcheck (Faz 11 sertleştirmesi Faz 00'da temel olarak uygulanır)
FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

# --- pnpm ---
FROM base AS deps
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/config/package.json packages/config/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile

# --- build ---
FROM deps AS build
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm --filter @santiyepro/contracts build \
  && pnpm --filter @santiyepro/api prisma:generate \
  && pnpm --filter @santiyepro/api build \
  && pnpm --filter @santiyepro/api --prod deploy /out/api

# --- runtime ---
FROM base AS runtime
ENV NODE_ENV=production
RUN addgroup -S app && adduser -S app -G app
COPY --from=build --chown=app:app /out/api /app
USER app
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://localhost:4000/api/v1/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
